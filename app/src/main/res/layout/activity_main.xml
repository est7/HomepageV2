<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!--face部分-->
        <com.example.homepagev2.widget.SquareNestedScrollFrameLayout
            android:id="@+id/face_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_behavior=".behavior.FaceBehavior">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/iv_face"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_gender"
                android:tag="iv_face" />

            <View
                android:id="@+id/v_mask"
                android:layout_width="match_parent"
                android:layout_gravity="bottom"
                android:layout_height="match_parent" />
        </com.example.homepagev2.widget.SquareNestedScrollFrameLayout>
        <!--face部分-->

        <!--UserInfo部分-->
        <com.example.homepagev2.widget.NestedScrollFrameLayout
            android:id="@+id/ll_userinfo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/userinfo_height"
            android:background="#7700ffff"
            app:layout_behavior=".behavior.UserInfoBehavior">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ll_userinfo"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.example.homepagev2.widget.NestedScrollFrameLayout>
        <!--UserInfo部分-->

        <!--TopBar部分-->
        <com.example.homepagev2.widget.TopBarLayout
            android:id="@+id/cl_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            app:layout_behavior=".behavior.TopBarBehavior">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginBottom="0dp"
                android:scaleType="center"
                android:src="@drawable/ic_launcher_background"
                app:layout_constraintBottom_toBottomOf="@+id/tv_top_bar_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_top_bar_name" />

            <TextView
                android:id="@+id/tv_top_bar_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="林俊杰"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_back" />

            <TextView
                android:id="@+id/tv_top_bar_coll"
                android:layout_width="72dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text="收藏"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_top_bar_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_top_bar_name" />
        </com.example.homepagev2.widget.TopBarLayout>
        <!--TopBar部分-->

        <!--TitleBar部分-->
        <com.example.homepagev2.widget.NestedScrollFrameLayout
            android:id="@+id/cls_title_bar_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_bar_height"
            app:layout_behavior=".behavior.TitleBarBehavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cls_title_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#88000000">

                <TextView
                    android:id="@+id/tv_cls_content_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="cls_title_bar"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:text="关注"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_cls_content_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_cls_content_name" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.example.homepagev2.widget.NestedScrollFrameLayout>
        <!--TitleBar部分-->

        <!--Content部分-->
        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:translationY="@dimen/content_trans_y"
            app:layout_behavior=".behavior.UnifiedPullBehavior">


            <com.google.android.material.tabs.TabLayout
                android:id="@+id/stl"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white" />
        </LinearLayout>
        <!--Content部分-->

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.example.homepagev2.widget.AnimatedNavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
